# ============================================================
# Document Converter — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ---- App -------------------------------------------------------
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ---- CORS ------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# NEVER use ["*"] in production — it breaks credentialed requests.
# Development defaults (pre-filled):
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Production example:
# ALLOWED_ORIGINS=["https://app.yourdomain.com","https://yourdomain.com"]

# ---- Redis -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- File Storage ----------------------------------------------
UPLOAD_DIR=/tmp/doc_converter/uploads
OUTPUT_DIR=/tmp/doc_converter/outputs
MAX_FILE_SIZE_MB=50

# ---- Conversion ------------------------------------------------
LIBREOFFICE_PATH=/usr/bin/libreoffice
JOB_TTL_SECONDS=3600      # seconds until job record expires in Redis
MAX_CONCURRENT_JOBS=10
